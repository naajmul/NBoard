<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!-- Auto-save interval in seconds -->
    <add key="AutoSaveInterval" value="30" />
    
    <!-- Default pen size -->
    <add key="DefaultPenSize" value="3" />
    
    <!-- Default pen color (hex) -->
    <add key="DefaultPenColor" value="#000000" />
    
    <!-- Documents folder path -->
    <add key="DocumentsFolder" value="Documents/NBoard" />
    
    <!-- Application theme (Light/Dark) -->
    <add key="Theme" value="Light" />
    
    <!-- Enable auto-save on startup -->
    <add key="EnableAutoSave" value="true" />
  </appSettings>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
</configuration>