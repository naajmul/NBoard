<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!-- Auto-save interval in seconds -->
    <add key="AutoSaveInterval" value="30" />
    
    <!-- Default pen size -->
    <add key="DefaultPenSize" value="3" />
    
    <!-- Documents folder path -->
    <add key="DocumentsFolder" value="Documents/NBoard" />
    
    <!-- Application theme -->
    <add key="Theme" value="Light" />
  </appSettings>
</configuration>