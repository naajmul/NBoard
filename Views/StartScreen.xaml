<Window x:Class="NBoard.Views.StartScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NBoard - Professional Whiteboard" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Background="#007ACC" Padding="30,20">
            <TextBlock Text="NBoard" FontSize="32" FontWeight="Bold" Foreground="White"/>
            <TextBlock Text="Professional Digital Whiteboard for Windows" FontSize="14" Foreground="#E0E0E0" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="40" Spacing="30">
                <!-- New Document Section -->
                <StackPanel>
                    <TextBlock Text="Start Creating" FontSize="20" FontWeight="Bold" Foreground="#333"/>
                    <Button Name="NewDocumentButton" Content="+ Create New Document" 
                            Padding="15,12" FontSize="14" Margin="0,15,0,0"
                            Click="NewDocumentButton_Click" Width="280" HorizontalAlignment="Left"
                            Background="#00A4EF"/>
                    <TextBlock Text="Start with a blank canvas" FontSize="12" Foreground="#999" Margin="0,5,0,0"/>
                </StackPanel>

                <!-- Recent Documents Section -->
                <StackPanel>
                    <TextBlock Text="Recent Documents" FontSize="20" FontWeight="Bold" Foreground="#333"/>
                    <ListBox Name="RecentDocumentsList" Height="300" Margin="0,15,0,0" 
                             Background="White" BorderThickness="1" BorderBrush="#DDD">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="15" BorderThickness="0,0,0,1" BorderBrush="#EEE" Background="White">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="#333"/>
                                            <TextBlock Text="{Binding Modified, StringFormat='Modified: {0:MMM dd, yyyy HH:mm}'}" 
                                                       FontSize="12" Foreground="#999" Margin="0,5,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <Button Content="Open" Padding="10,5" Background="#007ACC" Foreground="White"
                                                    Click="OpenDocument_Click" Tag="{Binding FilePath}"/>
                                            <Button Content="Delete" Padding="10,5" Background="#D32F2F" Foreground="White"
                                                    Click="DeleteDocument_Click" Tag="{Binding FilePath}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>

                <!-- Action Buttons -->
                <StackPanel Orientation="Horizontal" Spacing="15" Margin="0,20,0,0">
                    <Button Name="OpenFileButton" Content="📁 Open File" Padding="12,8" FontSize="12"
                            Click="OpenFileButton_Click" Background="#6C757D" Foreground="White"/>
                    <Button Name="SettingsButton" Content="⚙️ Settings" Padding="12,8" FontSize="12"
                            Click="SettingsButton_Click" Background="#6C757D" Foreground="White"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>